# D95 Gaming & Café - Frontend Environment Configuration
# ---------------------------------------------------------
# Copy this file to .env and provide your project values.
# IMPORTANT: NEVER place server secrets or service keys in this file.
# Any variable starting with VITE_ will be exposed to the public browser bundle.

# 1. Supabase Public Config
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-publishable-anon-key"

# 2. Cloudflare Turnstile Public Site Key (Required for Bot Protection)
VITE_TURNSTILE_SITE_KEY="0x00000000000000000000"


# =========================================================
# EDGE FUNCTION SECRETS (SERVER-SIDE ONLY)
# =========================================================
# The following variables MUST NOT be added to this .env file.
# They must be securely injected into the Supabase Edge Functions via the CLI:
# `supabase secrets set TURNSTILE_SECRET_KEY=your_secret_key`
# `supabase secrets set GEMINI_API_KEY=your_gemini_key`
#
# Required Secrets:
# - TURNSTILE_SECRET_KEY (For create-booking endpoint validation)
# - GEMINI_API_KEY       (For smart-waiter AI menu assistant)
#
# Note: SUPABASE_URL, SUPABASE_ANON_KEY, and SUPABASE_SERVICE_ROLE_KEY 
# are automatically provided to the Edge Functions by the Supabase runtime.
